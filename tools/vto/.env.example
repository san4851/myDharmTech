# OpenAI (Virtual Try-On)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-1

# Public base URL for this folder, e.g. https://tech.mydharm.com/tools/vto
VTO_PUBLIC_BASE_URL=

# 1 = show prepared prompt + raw OpenAI response. 0 = hide them.
VTO_DEBUG=0

# Web-sized OpenAI output (smaller/faster than high PNG).
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=auto
OPENAI_INPUT_FIDELITY=high
OPENAI_OUTPUT_FORMAT=webp
OPENAI_OUTPUT_COMPRESSION=70

# Extra shrink for the file we serve on the page (WebP; JPEG only if WebP is unavailable).
VTO_WEB_MAX_WIDTH=960
VTO_WEB_QUALITY=78

# Image generation can take 1–3 minutes. If the host returns "Request Timeout",
# raise LiteSpeed Connection Timeout (and LSAPI max process time) to 300.
