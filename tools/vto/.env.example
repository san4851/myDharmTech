# OpenAI (Virtual Try-On)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-1

# Public base URL for this folder, e.g. https://tech.mydharm.com/tools/vto
# Set this in production so generated image URLs are correct.
VTO_PUBLIC_BASE_URL=

# Image generation can take 1–3 minutes. If the host returns "Request Timeout",
# raise LiteSpeed Connection Timeout (and LSAPI max process time) to 300.
